# Environment Configuration Example
# Copy this file to .env and update with your settings
#
# IMPORTANT: Never commit .env to git - it contains secrets!

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Secret key for Flask sessions (MUST change in production!)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-token-hex

# Database URL
# Development (SQLite - default): Uses data/recipes.db automatically
# Production (PostgreSQL): Set DATABASE_URL environment variable on your hosting platform
#
# Leave commented for development (uses SQLite by default)
# DATABASE_URL=postgresql://user:password@localhost:5432/recipe_manager

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Port (defaults to 5000)
# PORT=5000

# Debug mode (defaults to False)
# FLASK_DEBUG=true
